PREFIX : <urn:kg-to-postgres:>
PREFIX ebucore: <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#>
PREFIX edm: <http://www.europeana.eu/schemas/edm/>
PREFIX graph: <https://data.hetarchief.be/graph/>
PREFIX haDes: <https://data.hetarchief.be/ns/description/>
PREFIX haLicId: <https://data.hetarchief.be/id/license/>
PREFIX haOrg: <https://data.hetarchief.be/ns/organization/>
PREFIX org: <http://www.w3.org/ns/org#>
PREFIX premis: <http://www.loc.gov/premis/rdf/v3/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rel: <http://id.loc.gov/vocabulary/preservation/relationshipSubType/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
prefix haObj: <https://data.hetarchief.be/ns/object/>

CONSTRUCT {
  ?annotation :tableName "graph.ebucore_annotation" ;
    :id ?annotation ;
    :has_annotation_related_artefact ?projected_thing ;
    :annotation_type ?annotation_type ;
    :is_ai_generated true ;
    :source "give" .

  ?annotation_media_fragment :tableName "graph.ebucore_annotation_is_annotated_media_resource" ;
    :ebucore_annotation_id ?annotation ;
    :ebucore_media_fragment_id ?media_fragment .

  ?captioning :tableName "graph.ebucore_has_captioning" ;
    :file_id ?o_file ;
    :ebucore_has_captioning ?caption_file .

  ?media_fragment :tableName "graph.ebucore_media_fragment" ;
    :id ?media_fragment ;
    :x ?x ;
    :y ?y ;
    :width ?width ;
    :height ?height ;
    :start_offset ?start_offset ;
    :end_offset ?end_offset ;
    :is_media_fragment_of ?o_file .

  ?caption_file :tableName "graph.file" ;
    :id ?caption_file ;
    :ebucore_has_mime_type ?file_ebucore_has_mime_type ;
    :edm_is_next_in_sequence ?file_edm_is_next_in_sequence ;
    :premis_original_name ?file_premis_original_name ;
    :premis_stored_at ?file_premis_stored_at ;
    :schema_duration ?file_schema_duration ;
    :schema_name ?file_schema_name ;
    :schema_thumbnail_url ?file_schema_thumbnail_url ;
    :mh_fragment_identifier ?mh_fragment_identifier ;
    :is_ai_generated true .

  ?projected_thing :tableName "graph.thing" ;
    :id ?projected_thing ;
    :schema_name ?thing_schema_name ;
    :schema_birth_date ?schema_birth_date ;
    :schema_birth_place ?schema_birth_place ;
    :schema_death_date ?schema_death_date ;
    :schema_death_place ?schema_death_place ;
    :type ?thing_type ;
    :wiki_id ?wiki_id ;
    :schema_thumbnail_url ?thing_schema_thumbnail_url .
}
WHERE {
  
  GRAPH graph:organization {
    ?schema_maintainer a haOrg:ContentPartner ;
      org:identifier ?maintainer_id
  }
  BIND(iri(concat("https://data.hetarchief.be/graph/metadata/", ?maintainer_id)) as ?ORGraph)

  GRAPH ?ORGraph {

    # Licensed intellectual-entity synopses
    VALUES ?ie_type {
      haDes:Audio
      haDes:Video
      haDes:Film
      haDes:DVD
      haDes:DVDChapter
    }
    ?ie a ?ie_type ;
      (schema:license | (rel:isp / schema:license)) ?schema_license ;
      prov:wasDerivedFrom / schema:dateModified ?modified .

    # Only include the right licenses
    FILTER (?schema_license IN ( 
        haLicId:VIAA-PUBLIEK-METADATA-LTD, 
        haLicId:VIAA-PUBLIEK-METADATA-ALL,
        haLicId:VIAA-PUBLIEK-CONTENT,
        haLicId:BEZOEKERTOOL-METADATA-ALL,
        haLicId:BEZOEKERTOOL-CONTENT ,
        haLicId:VIAA-INTRA_CP-METADATA-ALL ,
        haLicId:VIAA-INTRA_CP-CONTENT ,
        haLicId:Publiek-Domein,
        haLicId:COPYRIGHT-UNDETERMINED,
        haLicId:VIAA-INTRA_CP-METADATA-AI,
        haLicId:VIAA-PUBLIEK-METADATA-AI
    ))

    # TODO: does incremental make sense for this query?
    FILTER (!BOUND(?since) || ?modified >= ?since )

    # Bind files from same MH fragment as the accesscopy
    ?rep a haObj:DigitalRepresentation;
      haObj:isAccessCopyOf ?ie;
      rel:hss ?masterCopy;
      rel:hsr ?o_file.

    ?masterCopy haObj:isMasterCopyOf ?ie.
    ?o_file prov:wasDerivedFrom ?mh_fragment .

    GRAPH graph:annotations {

      # Annotations and their optional text positions
      ?annotation a ebucore:Annotation ;
        ebucore:annotationType ?annotation_type_uri ;
        ebucore:hasAnnotationRelatedArtefact ?thing ;
        ebucore:isAnnotatedMediaResource ?media_fragment .

      BIND(REPLACE(STR(?annotation_type_uri), "^.*/([^/]*)$", "$1") AS ?annotation_type)

      BIND(IRI(CONCAT(str(?annotation), "/", md5(str(?media_fragment)))) AS ?annotation_media_fragment)

      # Annotation-to-media-fragment links
      ?media_fragment a ebucore:MediaFragment ;
        ebucore:isMediaFragmentOf ?file .

      # Parse Media Fragments components from URL
      BIND(CONCAT("&", STRAFTER(STR(?media_fragment), "#")) AS ?fragment_parameters)
      OPTIONAL {
        FILTER(CONTAINS(?fragment_parameters, "&xywh="))
        BIND(STRBEFORE(CONCAT(STRAFTER(?fragment_parameters, "&xywh="), "&"), "&") AS ?xywh_value)
        BIND(REPLACE(?xywh_value, "^pixel:", "") AS ?xywh)
        BIND(xsd:integer (STRBEFORE(?xywh, ",")) AS ?x)
        BIND(STRAFTER(?xywh, ",") AS ?xywh_after_x)
        BIND(xsd:integer (STRBEFORE(?xywh_after_x, ",")) AS ?y)
        BIND(STRAFTER(?xywh_after_x, ",") AS ?xywh_after_y)
        BIND(xsd:integer (STRBEFORE(?xywh_after_y, ",")) AS ?width)
        BIND(xsd:integer (STRAFTER(?xywh_after_y, ",")) AS ?height)
      }
      OPTIONAL {
        FILTER(CONTAINS(?fragment_parameters, "&t="))
        BIND(STRBEFORE(CONCAT(STRAFTER(?fragment_parameters, "&t="), "&"), "&") AS ?time_value)
        BIND(REPLACE(?time_value, "^npt:", "") AS ?time_range)
        BIND(xsd:decimal (STRBEFORE(?time_range, ",")) AS ?start_offset)
        BIND(xsd:decimal (STRAFTER(?time_range, ",")) AS ?end_offset)
      }

      # Things referenced by annotations
      # all things have a name
      ?thing schema:name ?thing_schema_name .
      OPTIONAL { ?thing schema:sameAs ?wdt_thing . }
      BIND(COALESCE(?wdt_thing, ?thing) AS ?projected_thing)
      OPTIONAL {
        VALUES (?thing_type_uri ?thing_type) {
          (schema:Person "person")
          (schema:Place "place")
          (org:Organization "organization")
        }
        ?thing a ?thing_type_uri .
      }

      # Files used by annotations and captioning links
      ?file a premis:File ; prov:wasDerivedFrom ?mh_fragment .

      {}
      UNION {
        # File-to-caption-file links
        ?file a premis:File ;
          ebucore:hasCaptioning ?caption_file .

        BIND(IRI(CONCAT(str(?file), "/", md5(str(?caption_file)))) AS ?captioning)

        # 3. File
        ?caption_file a premis:File;
          schema:name ?file_schema_name ;
          premis:storedAt/rdf:value ?file_premis_stored_at ;
          ebucore:hasMimeType ?file_ebucore_has_mime_type .

        VALUES ?file_ebucore_has_mime_type {"application/json" "video/mp4" "audio/mp4" "application/x-subrip" "text/vtt" "audio/mpeg" "audio/m4a" "application/mp4" }
        FILTER (langMatches(lang(?file_schema_name), "nl"))

        { }
        UNION { ?caption_file premis:originalName ?file_premis_original_name . }
        UNION { ?caption_file edm:isNextInSequence ?file_edm_is_next_in_sequence . }
        UNION {
          ?caption_file schema:duration ?duration .
          BIND(STR(?duration) AS ?duration_string)
          BIND(IF(CONTAINS(?duration_string, "D"), xsd:decimal (REPLACE(?duration_string, "^P([0-9.]+)D.*$", "$1")), 0) AS
            ?days
          )
          BIND(IF(CONTAINS(?duration_string, "H"), xsd:decimal (REPLACE(?duration_string, "^.*T([0-9.]+)H.*$", "$1")), 0)
            AS ?hours
          )
          BIND(IF(CONTAINS(?duration_string, "T") && CONTAINS(STRAFTER(?duration_string, "T"), "M"), xsd:decimal (REPLACE(?duration_string,"^.*T(?:[0-9.]+H)?([0-9.]+)M.*$","$1")),0)
            AS ?minutes
          )
          BIND(IF(CONTAINS(?duration_string, "S"), xsd:decimal (REPLACE(?duration_string,"^.*T(?:[0-9.]+H)?(?:[0-9.]+M)?([0-9.]+)S$","$1")),0)
            AS ?seconds
          )
          BIND(?days * 86400 + ?hours * 3600 + ?minutes * 60 + ?seconds AS ?file_schema_duration)
        }
        UNION { ?caption_file schema:thumbnailUrl ?file_schema_thumbnail_url . }
        UNION { ?caption_file schema:identifier ?mh_fragment_identifier . }
      }
      # Thing bindings
      UNION {
        ?thing schema:birthDate ?birth_date .
        BIND(xsd:integer (SUBSTR(STR(?birth_date), 1, 4)) AS ?schema_birth_date)
      }
      UNION { ?thing schema:birthPlace / schema:name ?schema_birth_place . }
      UNION {
        ?thing schema:deathDate ?death_date .
        BIND(xsd:integer (SUBSTR(STR(?death_date), 1, 4)) AS ?schema_death_date)
      }
      UNION { ?thing schema:deathPlace / schema:name ?schema_death_place . }
      UNION { ?thing schema:identifier ?wiki_id . }
      UNION { ?thing schema:thumbnailUrl ?thing_schema_thumbnail_url . }
    }
  }
  
}
